# https://editorconfig.org — honored by Visual Studio and Rider out of the box.
root = true

[*]
# "utf-8" means UTF-8 *without* a BOM ("utf-8-bom" is the other option).
charset = utf-8
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
indent_style = space
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf

[*.sh]
end_of_line = lf
