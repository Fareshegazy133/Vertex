# ------------------------------------------------------------------
# Build output: everything here is regenerated by Scripts/Setup.bat
# ------------------------------------------------------------------
/Binaries/
/Intermediate/
/Vertex.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# ------------------------------------------------------------------
# Fetched third-party sources: the pinned tag + commit live in each
# ThirdParty/<Name>/<Name>.Module.lua, so the source itself is never committed
# ------------------------------------------------------------------
/ThirdParty/*/Source/

# ------------------------------------------------------------------
# IDE and OS state
# ------------------------------------------------------------------
.vs/
.idea/
*.DotSettings.user
Thumbs.db
.DS_Store
